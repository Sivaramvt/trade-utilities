      "#" + ROOT_ID + " .ti-pg-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid rgba(120,159,255,.14);cursor:move;user-select:none;}",
      "#" + ROOT_ID + " .ti-pg-title{font-size:14px;font-weight:700;letter-spacing:.02em;}",
      "#" + ROOT_ID + " .ti-pg-subtitle{font-size:11px;color:#91a8d6;margin-top:2px;}",
      "#" + ROOT_ID + " .ti-pg-body{padding:14px 16px 16px;}",
      "#" + ROOT_ID + " .ti-pg-section + .ti-pg-section{margin-top:16px;}",
      "#" + ROOT_ID + " .ti-pg-section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#84a6ea;margin-bottom:8px;}",
      "#" + ROOT_ID + " .ti-pg-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}",
      "#" + ROOT_ID + " .ti-pg-stat{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:10px;}",
      "#" + ROOT_ID + " .ti-pg-stat-label{font-size:11px;color:#93aad8;}",
      "#" + ROOT_ID + " .ti-pg-stat-value{font-size:16px;font-weight:700;margin-top:4px;}",
      "#" + ROOT_ID + " .ti-pg-list{display:flex;flex-direction:column;gap:8px;}",
      "#" + ROOT_ID + " .ti-pg-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px 12px;}",
      "#" + ROOT_ID + " .ti-pg-card.warn{border-color:rgba(255,190,92,.45);background:rgba(255,190,92,.12);}",
      "#" + ROOT_ID + " .ti-pg-card.urgent{border-color:rgba(255,128,83,.55);background:rgba(255,128,83,.12);}",
      "#" + ROOT_ID + " .ti-pg-card.exit_now{border-color:rgba(255,95,122,.65);background:rgba(255,95,122,.16);}",
      "#" + ROOT_ID + " .ti-pg-symbol{font-size:13px;font-weight:700;}",
      "#" + ROOT_ID + " .ti-pg-meta{margin-top:4px;font-size:11px;color:#b8c9eb;line-height:1.5;}",
      "#" + ROOT_ID + " .ti-pg-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}",
      "#" + ROOT_ID + " button,#" + ROOT_ID + " input,#" + ROOT_ID + " textarea{font:inherit;}",
      "#" + ROOT_ID + " .ti-pg-btn{border:0;border-radius:999px;padding:6px 10px;cursor:pointer;background:#1f4ed8;color:white;font-size:11px;}",
      "#" + ROOT_ID + " .ti-pg-btn.secondary{background:rgba(255,255,255,.08);color:#dce7ff;}",
      "#" + ROOT_ID + " .ti-pg-thresholds{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;}",
