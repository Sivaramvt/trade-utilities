// ==UserScript==
// @name         Zerodha Holdings Portfolio Guard
// @namespace    https://kite.zerodha.com/
// @version      0.2.0
// @description  Adds portfolio-risk nudges, blacklist support, pledged-stock handling, and local alerting to Zerodha holdings.
// @match        https://kite.zerodha.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
  "use strict";

  var STORAGE_KEY = "tiPortfolioGuardState";
  var STYLE_ID = "ti-portfolio-guard-style";
  var ROOT_ID = "ti-portfolio-guard-root";
  var TOGGLE_ID = "ti-portfolio-guard-toggle";
  var BANNER_ID = "ti-portfolio-guard-banner";
  var HOLDINGS_PATH_RE = /^\/holdings\/equity(?:\/)?$/;
  var SEVERITY_ORDER = { normal: 0, warn: 1, urgent: 2, exit_now: 3 };
  var HEADER_ALIASES = {
    symbol: ["instrument", "symbol", "stock", "tradingsymbol", "security", "name"],
    quantity: ["qty", "quantity", "available qty", "available quantity"],
    pledgedQuantity: ["pledged qty", "pledged quantity", "pledged"],
    averagePrice: ["avg", "avg. price", "average", "average price"],
    lastPrice: ["ltp", "last price", "price", "market price"],
    pnlPercent: ["p&l %", "pnl %", "gain %", "return %", "returns %"],
    pnlValue: ["p&l", "pnl", "gain/loss", "profit/loss", "unrealised p&l"],
    dayChange: ["day change %", "change %", "day change"]
  };
  var CODE_BLACKLIST = ["BECTORFOOD","COLPAL","JINDRILL","NITIRAJ","CENTRALBK"]
  var DEFAULTS = {
    thresholds: {
      warn: -3,
      urgent: -4,
      exit_now: -5
    },
    blacklist: CODE_BLACKLIST.slice(),
    hideBlacklistedRows: false,
    snoozes: {},
    alerts: {},
    notificationsEnabled: false,
    collapsed: false,
    panelPosition: {
      top: 88,
      right: 18,
      left: null
    }
  };
  var state = loadState();
  var renderTimer = null;
  var suppressRenderUntil = 0;
  var lastRenderedView = {
    type: "debug",
    debug: {
      route: window.location.pathname,
      tables: 0,
      matchedTables: 0
    },
    holdings: []
  };
  var dragState = {
    active: false,
    startX: 0,
    startY: 0,
    startTop: 88,
    startLeft: 0
  };

  function cloneDefaults() {
    return JSON.parse(JSON.stringify(DEFAULTS));
  }

  function loadState() {
    var base = cloneDefaults();
    try {
      var raw = window.localStorage.getItem(STORAGE_KEY);
      var parsed = raw ? JSON.parse(raw) : {};
      if (!parsed || typeof parsed !== "object") {
        parsed = {};
      }
      base.thresholds = mergeObjects(base.thresholds, parsed.thresholds || {});
      base.blacklist = normalizeSymbolList(CODE_BLACKLIST);
      base.hideBlacklistedRows = Boolean(parsed.hideBlacklistedRows);
      base.snoozes = parsed.snoozes && typeof parsed.snoozes === "object" ? parsed.snoozes : {};
      base.alerts = parsed.alerts && typeof parsed.alerts === "object" ? parsed.alerts : {};
      base.notificationsEnabled = Boolean(parsed.notificationsEnabled);
      base.collapsed = Boolean(parsed.collapsed);
      if (parsed.panelPosition && typeof parsed.panelPosition === "object") {
        base.panelPosition = mergeObjects(base.panelPosition, parsed.panelPosition);
      }
    } catch (error) {
      console.warn("Portfolio guard: failed to load state", error);
    }
    return base;
  }

  function mergeObjects(left, right) {
    var out = {};
    var key;
    for (key in left) {
      if (Object.prototype.hasOwnProperty.call(left, key)) {
        out[key] = left[key];
      }
    }
    for (key in right) {
      if (Object.prototype.hasOwnProperty.call(right, key)) {
        out[key] = right[key];
      }
    }
    return out;
  }

  function saveState() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify({
        thresholds: state.thresholds,
        hideBlacklistedRows: state.hideBlacklistedRows,
        snoozes: state.snoozes,
        alerts: state.alerts,
        notificationsEnabled: state.notificationsEnabled,
        collapsed: state.collapsed,
        panelPosition: state.panelPosition
      }));
    } catch (error) {
      console.warn("Portfolio guard: failed to save state", error);
    }
  }

  function suppressRenders(ms) {
    suppressRenderUntil = Date.now() + ms;
  }

  function normalizeLabel(value) {
    return String(value || "")
      .toLowerCase()
      .replace(/\s+/g, " ")
      .replace(/[^\w% ]+/g, "")
      .trim();
  }

  function normalizeSymbol(value) {
    return String(value || "")
      .toUpperCase()
      .replace(/[^A-Z0-9_-]/g, "")
      .trim();
  }

  function normalizeSymbolList(items) {
    var seen = {};
    var out = [];
    var i;
    for (i = 0; i < items.length; i += 1) {
      var symbol = normalizeSymbol(items[i]);
      if (symbol && !seen[symbol]) {
        seen[symbol] = true;
        out.push(symbol);
      }
    }
    return out;
  }

  function parseNumber(value) {
    if (typeof value === "number") {
      return isFinite(value) ? value : null;
    }
    var text = String(value || "")
      .replace(/₹|,|%/g, "")
      .replace(/\s+/g, " ")
      .trim();
    if (!text) return null;
    var match = text.match(/-?\d+(\.\d+)?/);
    if (!match) return null;
    var parsed = Number(match[0]);
    return isFinite(parsed) ? parsed : null;
  }

  function formatPct(value) {
    return Number(value || 0).toFixed(2) + "%";
  }

  function formatMoney(value) {
    return "Rs " + Number(value || 0).toLocaleString("en-IN", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function isHoldingsRoute() {
    return HOLDINGS_PATH_RE.test(window.location.pathname);
  }

  function ensureStyles() {
